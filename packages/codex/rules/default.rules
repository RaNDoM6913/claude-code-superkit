prefix_rule(pattern=["pytest"], decision="allow")
prefix_rule(pattern=["jest"], decision="allow")
prefix_rule(pattern=["vitest"], decision="allow")
prefix_rule(pattern=["mocha"], decision="allow")
prefix_rule(pattern=["eslint"], decision="allow")
prefix_rule(pattern=["prettier"], decision="allow")
prefix_rule(pattern=["ruff"], decision="allow")
prefix_rule(pattern=["black"], decision="allow")
prefix_rule(pattern=["mypy"], decision="allow")
prefix_rule(pattern=["tsc"], decision="allow")
prefix_rule(pattern=["golangci-lint"], decision="allow")
prefix_rule(pattern=["gofmt"], decision="allow")
prefix_rule(pattern=["clippy"], decision="allow")
prefix_rule(pattern=["rustfmt"], decision="allow")

# =============================================================================
# FALLBACK
# =============================================================================
# Anything not matched above falls through to Codex CLI's own approval policy.
