# =============================================================================
# DOCKER / KUBERNETES — read allowed, destructive prompt
# =============================================================================

prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["docker", "logs"], decision="allow")
prefix_rule(pattern=["docker", "inspect"], decision="allow")
prefix_rule(pattern=["docker", "images"], decision="allow")
prefix_rule(pattern=["docker", "build"], decision="allow")
prefix_rule(pattern=["docker", "run"], decision="allow")
prefix_rule(pattern=["docker", "compose"], decision="allow")
prefix_rule(pattern=["docker-compose"], decision="allow")

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "prompt",
    justification = "Prune deletes containers, images, networks, and build cache. Confirm scope.",
)
prefix_rule(
    pattern = ["docker", "volume", "prune"],
    decision = "prompt",
    justification = "Volume prune deletes anonymous volumes — possibly with data.",
)

prefix_rule(pattern=["kubectl", "get"], decision="allow")
prefix_rule(pattern=["kubectl", "describe"], decision="allow")
prefix_rule(pattern=["kubectl", "logs"], decision="allow")
prefix_rule(pattern=["kubectl", "exec"], decision="allow")
prefix_rule(pattern=["kubectl", "apply"], decision="allow")
prefix_rule(pattern=["kubectl", "rollout"], decision="allow")

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "kubectl delete removes cluster resources. Confirm namespace + resource.",
)

# =============================================================================
# SYSTEMD / SERVICE MANAGERS — restart allowed, enable/disable prompt
# =============================================================================

prefix_rule(pattern=["systemctl", "status"], decision="allow")
prefix_rule(pattern=["systemctl", "start"], decision="allow")
prefix_rule(pattern=["systemctl", "stop"], decision="allow")
prefix_rule(pattern=["systemctl", "restart"], decision="allow")
prefix_rule(pattern=["systemctl", "reload"], decision="allow")

prefix_rule(
    pattern = ["systemctl", "enable"],
    decision = "prompt",
    justification = "Changing boot-time service state affects the host.",
)
prefix_rule(
    pattern = ["systemctl", "disable"],
    decision = "prompt",
    justification = "Changing boot-time service state affects the host.",
)
prefix_rule(
    pattern = ["systemctl", "mask"],
    decision = "prompt",
    justification = "Masking services can break host behavior.",
)

prefix_rule(pattern=["pm2", "list"], decision="allow")
prefix_rule(pattern=["pm2", "logs"], decision="allow")
prefix_rule(pattern=["pm2", "describe"], decision="allow")
prefix_rule(pattern=["pm2", "start"], decision="allow")
prefix_rule(pattern=["pm2", "restart"], decision="allow")
prefix_rule(pattern=["pm2", "reload"], decision="allow")
prefix_rule(pattern=["pm2", "stop"], decision="allow")
prefix_rule(
    pattern = ["pm2", "delete"],
    decision = "prompt",
    justification = "pm2 delete removes a process from the manager — confirm name.",
)

prefix_rule(pattern=["supervisorctl", "status"], decision="allow")
prefix_rule(pattern=["supervisorctl", "restart"], decision="allow")
prefix_rule(pattern=["supervisorctl", "start"], decision="allow")
prefix_rule(pattern=["supervisorctl", "stop"], decision="allow")

# =============================================================================
# WEB SERVERS — config check + reload allowed; full restart prompt
# =============================================================================

prefix_rule(pattern=["nginx", "-t"], decision="allow")
prefix_rule(pattern=["nginx", "-s", "reload"], decision="allow")
prefix_rule(pattern=["caddy", "validate"], decision="allow")
prefix_rule(pattern=["caddy", "reload"], decision="allow")
prefix_rule(pattern=["apachectl", "configtest"], decision="allow")
prefix_rule(pattern=["apachectl", "graceful"], decision="allow")

# =============================================================================
# OBSERVABILITY / SHELL UTILS — universally safe reads
# =============================================================================

prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["less"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["fd"], decision="allow")
prefix_rule(pattern=["which"], decision="allow")
prefix_rule(pattern=["whoami"], decision="allow")
prefix_rule(pattern=["hostname"], decision="allow")
prefix_rule(pattern=["env"], decision="allow")
prefix_rule(pattern=["date"], decision="allow")
prefix_rule(pattern=["uname"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["top"], decision="allow")
prefix_rule(pattern=["htop"], decision="allow")
prefix_rule(pattern=["df"], decision="allow")
prefix_rule(pattern=["du"], decision="allow")
prefix_rule(pattern=["free"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["yq"], decision="allow")
prefix_rule(pattern=["sed"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["echo"], decision="allow")
prefix_rule(pattern=["printf"], decision="allow")
prefix_rule(pattern=["http"], decision="allow")

# NOTE on curl | bash:
# Codex CLI passes individual argv arrays to the rule engine; shell pipes
# are not visible as argv tokens. A `curl URL | bash` is observed as two
# separate executions: argv=["curl", "URL"] then argv=["bash"]. We cannot
# match the pipe semantically from this layer.
# Therefore: curl and wget land at decision="prompt" so the user sees
# the URL before any fetch. Real defense against curl|bash is at the
# shell/sandbox layer, not here.
prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "Curl may be piped into a shell. Confirm URL and target.",
)
prefix_rule(
    pattern = ["wget"],
    decision = "prompt",
    justification = "Wget may be piped into a shell. Confirm URL and target.",
)
prefix_rule(
    pattern = ["bash", "-c"],
    decision = "prompt",
    justification = "Arbitrary inline shell. Inspect the command before running.",
)
prefix_rule(
    pattern = ["sh", "-c"],
    decision = "prompt",
    justification = "Arbitrary inline shell. Inspect the command before running.",
)

# =============================================================================
# DATABASE CLIENTS — read allowed, destructive prompt
# =============================================================================

prefix_rule(pattern=["psql"], decision="allow")
prefix_rule(pattern=["mysql"], decision="allow")
prefix_rule(pattern=["redis-cli"], decision="allow")
prefix_rule(pattern=["sqlite3"], decision="allow")
prefix_rule(pattern=["mongosh"], decision="allow")

prefix_rule(
    pattern = ["pg_dump"],
    decision = "allow",
    justification = "Read-only backup operation.",
)
prefix_rule(
    pattern = ["dropdb"],
    decision = "prompt",
    justification = "dropdb removes a database. Confirm name.",
)
prefix_rule(
    pattern = ["psql", "-c", "DROP"],
    decision = "prompt",
    justification = "DROP statement via psql -c removes DB objects. Confirm.",
)
prefix_rule(
    pattern = ["psql", "-c", "TRUNCATE"],
    decision = "prompt",
    justification = "TRUNCATE wipes table data. Confirm.",
)
prefix_rule(
    pattern = ["kubectl", "drain"],
    decision = "prompt",
    justification = "kubectl drain evicts pods from a node. Confirm.",
)
prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "prompt",
    justification = "terraform destroy tears down infrastructure. Confirm targets.",
)
prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "prompt",
    justification = "terraform apply mutates infrastructure. Confirm plan.",
)
prefix_rule(
    pattern = ["redis-cli", "FLUSHDB"],
    decision = "prompt",
    justification = "FLUSHDB wipes the current Redis DB.",
)
prefix_rule(
    pattern = ["redis-cli", "FLUSHALL"],
    decision = "prompt",
    justification = "FLUSHALL wipes ALL Redis DBs.",
)

# =============================================================================
