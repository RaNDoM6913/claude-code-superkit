# default.rules — Codex CLI approval policy for claude-code-superkit
#
# DSL format (adapted from VKirill/codex-starter-kit, MIT):
#   prefix_rule(pattern=[...], decision="allow|forbidden|prompt", justification="...", match=[...])
#
# Decisions:
#   allow      — Codex executes silently
#   prompt     — Codex asks user before executing
#   forbidden  — Codex refuses to execute
#
# Pattern matching is a prefix tuple match against the command argv.
# More-specific patterns take precedence over more-general ones.
#
# Philosophy: maximize developer flow for safe commands; require approval
# for state-changing operations; forbid destructive system calls.

# =============================================================================
# DESTRUCTIVE — never allowed
# =============================================================================

prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Recursive deletion of root filesystem is irrecoverable.",
)

prefix_rule(
    pattern = ["rm", "-rf", "/*"],
    decision = "forbidden",
    justification = "Recursive deletion of root filesystem is irrecoverable.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is blocked. Ask the user for an explicit one-off elevated command if needed.",
)

prefix_rule(
    pattern = ["dd", "if="],
    decision = "forbidden",
    justification = "Raw disk writes can destroy data. Use a safer file-level tool.",
    match = ["dd if=/dev/zero of=/dev/sda", "dd if=image.iso of=/dev/disk2"],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Formatting filesystems must be performed manually by the user.",
)

prefix_rule(
    pattern = ["wipefs"],
    decision = "forbidden",
    justification = "Filesystem signature wiping must be performed manually by the user.",
)

prefix_rule(
    pattern = ["shutdown"],
    decision = "forbidden",
    justification = "System shutdown must be performed manually by the user.",
)

prefix_rule(
    pattern = ["reboot"],
    decision = "forbidden",
    justification = "System reboot must be performed manually by the user.",
)

prefix_rule(
    pattern = ["halt"],
    decision = "forbidden",
    justification = "System halt must be performed manually by the user.",
)

prefix_rule(
    pattern = ["shred"],
    decision = "forbidden",
    justification = "Secure deletion is irreversible. Use trash or ask for explicit approval.",
)

# =============================================================================
# PERMISSION / OWNERSHIP — always ask
# =============================================================================

prefix_rule(
    pattern = ["chmod"],
    decision = "prompt",
    justification = "Permission changes can expose secrets or break apps. Ask for exact target + mode.",
    match = ["chmod -R 777 .", "chmod 600 .env"],
)

prefix_rule(
    pattern = ["chown"],
    decision = "prompt",
    justification = "Ownership changes can break workspace permissions.",
)

# =============================================================================
# RM — case-by-case (root forbidden above, named paths require prompt)
# =============================================================================

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "Confirm exact target before deletion. Prefer trash where available.",
    match = ["rm node_modules", "rm -rf .next/cache"],
)

# =============================================================================
# GIT — most allowed; force-push and reset --hard require approval upstream
# =============================================================================

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "blame"], decision="allow")
prefix_rule(pattern=["git", "branch"], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "pull"], decision="allow")
prefix_rule(pattern=["git", "merge"], decision="allow")
prefix_rule(pattern=["git", "rebase"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "config"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")

# NOTE on git push --force coverage:
# prefix_rule matches as an argv prefix tuple. `git push --force origin main`
# matches ["git", "push", "--force"], but `git push origin main --force`
# does NOT — the flag lands on position 4, not 2. Codex CLI's rule engine
# does not support substring/regex on argv tails. So `git push` is left
# as decision="prompt" rather than "allow" so the user is asked for every
# push (one extra confirmation is the price of not getting silently
# force-pushed by argv-position trickery). Real protection of main branch
# happens at the host (GitHub branch protection rules), not here.
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "prompt",
    justification = "Force-push rewrites remote history. Confirm branch and target.",
)
prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "prompt",
    justification = "Force-push rewrites remote history. Confirm branch and target.",
)
prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "prompt",
    justification = "Force-push (safer variant) still rewrites remote history.",
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push touches remote state and may carry a --force flag after the ref. Confirm.",
)

# Same argv-position caveat for reset --hard. We keep `git reset` at prompt
# rather than allow so `git reset HEAD --hard` (--hard at position 3) still
# triggers a confirmation.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset discards uncommitted work. Confirm target ref.",
)
prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Reset may include --hard after the ref. Confirm.",
)

prefix_rule(
    pattern = ["git", "clean", "-fdx"],
    decision = "prompt",
    justification = "git clean -fdx removes untracked files and ignored dirs (incl. node_modules). Confirm.",
)
prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "prompt",
    justification = "git clean -fd removes untracked files. Confirm.",
)

# =============================================================================
# GH CLI — most allowed
# =============================================================================

prefix_rule(pattern=["gh", "pr"], decision="allow")
prefix_rule(pattern=["gh", "issue"], decision="allow")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow")
prefix_rule(pattern=["gh", "repo", "list"], decision="allow")
prefix_rule(pattern=["gh", "release"], decision="allow")
prefix_rule(pattern=["gh", "workflow"], decision="allow")
prefix_rule(pattern=["gh", "run"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Repository deletion is permanent. Must be done by the user manually.",
)

# =============================================================================
# NPM / PNPM / YARN — installs and reads allowed, publish/unpublish prompt
# =============================================================================

prefix_rule(pattern=["npm", "view"], decision="allow")
prefix_rule(pattern=["npm", "info"], decision="allow")
prefix_rule(pattern=["npm", "search"], decision="allow")
prefix_rule(pattern=["npm", "ping"], decision="allow")
prefix_rule(pattern=["npm", "config", "get"], decision="allow")
prefix_rule(pattern=["npm", "list"], decision="allow")
prefix_rule(pattern=["npm", "ls"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["npm", "ci"], decision="allow")
prefix_rule(pattern=["npm", "run"], decision="allow")
prefix_rule(pattern=["npm", "test"], decision="allow")
prefix_rule(pattern=["npm", "audit"], decision="allow")
prefix_rule(pattern=["npm", "outdated"], decision="allow")

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Publishing pushes a package to the registry. Confirm version, scope, and tag.",
)
prefix_rule(
    pattern = ["npm", "unpublish"],
    decision = "prompt",
    justification = "Unpublishing is mostly irreversible and breaks dependents.",
)

prefix_rule(pattern=["pnpm"], decision="allow")
prefix_rule(pattern=["yarn"], decision="allow")
prefix_rule(pattern=["bun"], decision="allow")
prefix_rule(pattern=["npx"], decision="allow")

# =============================================================================
# PYTHON / PIP / UV
# =============================================================================

prefix_rule(pattern=["python"], decision="allow")
prefix_rule(pattern=["python3"], decision="allow")
prefix_rule(pattern=["pip"], decision="allow")
prefix_rule(pattern=["pip3"], decision="allow")
prefix_rule(pattern=["uv"], decision="allow")
prefix_rule(pattern=["poetry"], decision="allow")
prefix_rule(pattern=["pipx"], decision="allow")

# =============================================================================
# GO / RUST / OTHER COMPILERS
# =============================================================================

prefix_rule(pattern=["go"], decision="allow")
prefix_rule(pattern=["cargo"], decision="allow")
prefix_rule(pattern=["rustc"], decision="allow")
prefix_rule(pattern=["javac"], decision="allow")
prefix_rule(pattern=["mvn"], decision="allow")
prefix_rule(pattern=["gradle"], decision="allow")
